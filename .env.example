# RAGForge — copiez en .env et renseignez. NE JAMAIS commiter de vraie clé.

# --- LLM (client compatible OpenAI : Ollama, OpenAI, GLM/Z.AI, vLLM…) ---
# Repli automatique en mode extractif si l'endpoint ne répond pas.
RAGFORGE_LLM_BASE_URL=http://localhost:11434/v1
RAGFORGE_LLM_API_KEY=not-needed
RAGFORGE_LLM_MODEL=qwen2.5:7b
RAGFORGE_LLM_BACKEND=openai_compat

# --- Embeddings sémantiques (optionnel, nécessite pip install .[embeddings]) ---
# RAGFORGE_EMBEDDING_BACKEND=e5
# RAGFORGE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Vector store (optionnel, nécessite pip install .[chroma]) ---
# RAGFORGE_VECTOR_BACKEND=chroma

# --- Reranking (activer SEULEMENT si l'eval le justifie, nécessite .[embeddings]) ---
# RAGFORGE_RERANK_ENABLED=true
